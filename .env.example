# Copia este archivo como .env en el servidor. NUNCA lo subas a git.

# --- Acceso al panel (obligatorio). Sin PANEL_PASSWORD el panel no abre.
# Mínimo 8 caracteres; usa una frase larga.
PANEL_PASSWORD="pon-aqui-una-contraseña-larga"
# Genera uno con: openssl rand -hex 32
SESSION_SECRET=""

# --- Sitio y datos
# Subdominio de esta app (se usa en el enlace de baja de los correos).
PUBLIC_BASE_URL=https://outreach.customania.com.co
# Base de datos y catálogos (haz respaldo de esta carpeta).
DATA_DIR=./data
SENDER_NAME="Jorge | Customania"
# Puerto donde escucha esta app (Nginx le hace proxy). Distinto al del sitio principal en el mismo VPS.
HOST=127.0.0.1
PORT=4322

# --- Cuenta 1: Gmail / Google Workspace (contraseña de aplicación; requiere verificación en 2 pasos)
GMAIL_USER=tucorreo@gmail.com
GMAIL_PASSWORD="xxxx xxxx xxxx xxxx"
GMAIL_DAILY_LIMIT=40

# --- Cuenta 2: correo del dominio (SMTP/IMAP de tu hosting o servidor de correo)
DOMAIN_USER=contacto@customania.com.co
DOMAIN_PASSWORD=""
DOMAIN_SMTP_HOST=mail.customania.com.co
DOMAIN_SMTP_PORT=465
DOMAIN_IMAP_HOST=mail.customania.com.co
DOMAIN_DAILY_LIMIT=40

# --- Ajustes de envío
DELAY_MIN=40
DELAY_MAX=110
FOLLOWUP_DAYS=6

# --- Catálogo PDF
TIENDA_URL=https://tienda.customania.com.co
CATALOG_MAX_PRODUCTS=40
